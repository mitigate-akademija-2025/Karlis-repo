<p class="text-green-600 mb-4"><%= notice %></p>

<div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg p-8 mt-8">
  <%= render partial: "quiz", locals: { quiz: @quiz } %>

  <% if @quiz.questions.any? %>
    <h2 class="text-2xl font-semibold mt-8 mb-4 text-blue-800">Questions</h2>
    <ul class="list-disc list-inside space-y-2">
      <% @quiz.questions.each do |question| %>
        <li class="pl-2"><%= question.name %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 mt-8">No questions for this quiz yet.</p>
  <% end %>

  <h2 class="text-xl font-semibold mt-8 mb-4">Reviews</h2>
  <% @quiz.reviews.each do |review| %>
    <div class="mb-4 p-4 bg-white rounded shadow">
      <p class="text-gray-800"><%= review.content %></p>
      <p class="text-sm text-gray-500">by <%= review.user.username %></p>
    </div>
  <% end %>

  <div class="mt-8 flex flex-wrap gap-4">
    <% if @quiz.user == current_user || current_user&.admin? %>
      <%= link_to "Edit", edit_quiz_path(@quiz), class: "bg-yellow-500 text-white px-4 py-2 rounded mr-2" %>
      <%= link_to "Delete", quiz_path(@quiz), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-600 text-white px-4 py-2 rounded" %>
    <% end %>

    <%= link_to "Take Quiz", take_quiz_path(@quiz), class: "bg-blue-600 text-white px-4 py-2 rounded mr-2" %>
    <%= link_to "Back to Quizzes", quizzes_path, class: "bg-gray-400 text-white px-4 py-2 rounded" %>
  </div>
</div>
