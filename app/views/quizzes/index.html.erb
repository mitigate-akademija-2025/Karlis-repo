<p class="text-green-600"><%= notice %></p>
<% content_for :title, "Quizzes" %>

<div class="flex flex-col items-center w-full">
  <h1 class="text-3xl font-bold mb-8 text-blue-700 text-center">Quizzes</h1>

  <% if user_signed_in? %>
    <div class="mb-6 flex justify-center w-full">
      <%= link_to "Create Quiz", new_quiz_path, class: "bg-green-600 text-white px-6 py-3 rounded text-lg font-semibold" %>
    </div>
  <% end %>

  <div class="mb-6 w-full max-w-md flex justify-center">
    <%= form_with url: quizzes_path, method: :get, local: true do |f| %>
      <div class="flex w-full">
        <%= f.text_field :q, value: params[:q], placeholder: "Search quizzes...", class: "w-full border rounded-l px-3 py-2 text-center" %>
        <%= f.submit "Search", class: "bg-blue-500 text-white px-4 py-2 rounded-r" %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 w-full max-w-5xl">
    <% @quizzes.each do |quiz| %>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <h2 class="text-lg font-semibold mb-2 text-center">
          <%= link_to quiz.title, quiz_path(quiz), class: "text-blue-700 hover:underline" %>
        </h2>
        <p class="text-gray-600 mb-2 text-center"><%= quiz.description %></p>
        <%= link_to "Take Quiz", take_quiz_path(quiz), class: "bg-blue-500 text-white px-3 py-1 rounded mt-auto" %>
      </div>
    <% end %>
  </div>
</div>
